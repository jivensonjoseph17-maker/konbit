# ---------------------------------------------------------------
# Konbit — .gitignore
# ---------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual env
venv/
venv*/
env/
ENV/
.venv/
pyvenv.cfg

# Varyab anviwonman — PA JANM KOMITE SA YO
.env
.env.*
!.env.example

# Baz done
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Alembic — kachèt sèlman.
# MIGRASYON YO (alembic/versions/*.py) DWE ALE NAN GIT.
# Se yo ki istwa estrikti baz done a: san yo, yon sèvè pwodiksyon
# pa ka rebati menm estrikti a ak `alembic upgrade head`.
alembic/__pycache__/
alembic/versions/__pycache__/
alembic/versions/*.pyc

# Dokiman anplwaye yo telechaje (CV, sètifika doktè, kontra)
# Se done pèsonèl — yo pa dwe janm rive sou GitHub
uploads/
!uploads/.gitkeep
media/

# Lòg
*.log
logs/

# Tès ak koutvèti
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Editè
.vscode/
.idea/
*.swp
*.swo
*~

# Node / frontend
node_modules/
.parcel-cache/
.next/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-error.log*

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini